# Copy this file to .env and fill it in:   cp .env.example .env
# Both compose files read it. Lines starting with # are ignored.

# ---- Folders on this computer ------------------------------------------------
# Your music library. Crate files finished albums here and scans it for albums you
# already have.
MUSIC_DIR=/path/to/your/music
# Where slskd puts finished downloads. Crate moves albums from here into MUSIC_DIR.
#  - Crate + slskd setup: any empty folder, e.g. ./downloads
#  - existing slskd: the host folder your slskd writes completed downloads to
DOWNLOADS_DIR=./downloads

# User/group that owns your music files (run `id` to see yours). Both containers run
# as this user so new files aren't owned by root.
PUID=1000
PGID=1000

# ---- slskd API key -----------------------------------------------------------
# Long random string, 16+ characters. Generate one with:  openssl rand -hex 24
# Crate + slskd setup: slskd is created with this key automatically.
# existing slskd: paste the API key you configured in slskd.
SLSKD_API_KEY=change-me-to-a-long-random-string

# ---- Crate -------------------------------------------------------------------
CRATE_PORT=9325
# Image version to run: "latest", or pin one like 1.1.0. Update with:
#   docker compose pull && docker compose up -d
CRATE_VERSION=latest
# Sent to MusicBrainz in the User-Agent, as they ask (an email or URL).
MB_CONTACT=you@example.com

# ---- Crate + slskd setup only (docker-compose.yml) ---------------------------
# Your Soulseek account. A new username is registered automatically the first
# time you log in with it.
SOULSEEK_USERNAME=your_soulseek_username
SOULSEEK_PASSWORD=your_soulseek_password
# Login for slskd's own web UI (http://localhost:5030). Change these.
SLSKD_WEB_USERNAME=slskd
SLSKD_WEB_PASSWORD=change-me
# Port other Soulseek users connect to you on. Forward it on your router for best results.
SLSKD_LISTEN_PORT=50300

# ---- existing slskd setup only (docker-compose.existing-slskd.yml) -----------
# Address of your slskd as seen from inside the Crate container:
#   slskd on this machine (not in Docker, or Docker with port 5030 published):
#       http://host.docker.internal:5030
#   slskd on another machine:   http://192.168.1.50:5030
#   slskd container on a shared Docker network:   http://slskd:5030
SLSKD_URL=http://host.docker.internal:5030
